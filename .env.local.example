# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Stripe (LIVE keys — billing is live from day one) ─────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs — create these in the Stripe dashboard first
STRIPE_PRICE_STARTER=price_xxxxx      # CAD $29/month — up to 5 properties
STRIPE_PRICE_LANDLORD=price_xxxxx     # CAD $79/month — up to 20 properties
STRIPE_PRICE_PORTFOLIO=price_xxxxx    # CAD $149/month — unlimited

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
